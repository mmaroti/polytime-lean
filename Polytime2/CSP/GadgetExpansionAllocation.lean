import Polytime2.CSP.GadgetAllocation
import Polytime2.CSP.GadgetExpansion

/-! # Fixed-pool allocation for the Boolean gadget expansion

Allocate every fixed gadget kind in each occurrence's pool and collapse the
unused components. The resulting quotient has exactly the variables of the
mathematical expansion. Raw allocation has a fixed linear size formula.
Relation insertion and certification of the allocating computation are
separate obligations.
-/

namespace Polytime2.CSP.GadgetExpansion

open FirstOrder FirstOrder.Language GadgetAllocation

universe languageLevel carrierLevel

variable {L : Language.{languageLevel, languageLevel}} [L.IsRelational]
variable {Carrier : Type carrierLevel} [L.Structure Carrier] [Finite Carrier]
variable {dimension : ℕ}
variable (domainFormula : L.Formula (Fin dimension))
variable (clauseFormulas : (Fin 3 → Bool) → L.Formula (Fin 3 × Fin dimension))

/-- One specialization-fixed pool contains a component for every gadget kind. -/
abbrev Pool := Σ kind : Kind, Host (Carrier := Carrier) domainFormula clauseFormulas kind

/-- Raw shared variables followed by a uniform pool for each fresh copy. -/
abbrev AllocatedVariables {variableCount : ℕ} (formula : SAT.Formula (Fin variableCount)) :=
  (Fin variableCount × Fin dimension) ⊕
    ((Fin variableCount ⊕ Fin formula.length) × Pool (Carrier := Carrier) domainFormula clauseFormulas)

omit [L.IsRelational] in
theorem allocatedVariables_card {variableCount : ℕ} (formula : SAT.Formula (Fin variableCount)) :
    Nat.card (AllocatedVariables (Carrier := Carrier) domainFormula clauseFormulas formula) =
      variableCount * dimension + (variableCount + formula.length) *
        Nat.card (Pool (Carrier := Carrier) domainFormula clauseFormulas) := by
  simp only [AllocatedVariables, Nat.card_sum, Nat.card_prod, Nat.card_fin]

variable [Nonempty Carrier]

private noncomputable def defaultHost (kind : Kind) :
    Host (Carrier := Carrier) domainFormula clauseFormulas kind :=
  fun _ => Classical.choice (inferInstance : Nonempty Carrier)

/-- The fixed local relation table on the uniform pool, projected to the
selected gadget. This is specialization data, independent of the input formula. -/
noncomputable def poolRelation (kind : Kind) {arity : ℕ} (symbol : L.Relations arity)
    (tuple : Fin arity → Pool (Carrier := Carrier) domainFormula clauseFormulas) : Prop := by
  classical
  exact Structure.RelMap symbol (fun coordinate =>
    poolProjection (defaultHost (Carrier := Carrier) domainFormula clauseFormulas) kind (tuple coordinate))

/-- Collapse a pool variable onto the component selected for this occurrence. -/
noncomputable def selectedPool (kind : Kind)
    (value : Pool (Carrier := Carrier) domainFormula clauseFormulas) :
    Pool (Carrier := Carrier) domainFormula clauseFormulas := by
  classical
  exact ⟨kind, poolProjection (defaultHost (Carrier := Carrier) domainFormula clauseFormulas) kind value⟩

/-- A boundary variable of the selected component, included in the pool. -/
noncomputable def poolBoundary (kind : Kind) (coordinate : BoundaryVariables dimension kind) :
    Pool (Carrier := Carrier) domainFormula clauseFormulas :=
  ⟨kind, boundary (Carrier := Carrier) domainFormula clauseFormulas kind coordinate⟩

omit [L.IsRelational] [Finite Carrier] in
theorem selectedPool_idempotent (kind : Kind)
    (value : Pool (Carrier := Carrier) domainFormula clauseFormulas) :
    selectedPool domainFormula clauseFormulas kind
      (selectedPool domainFormula clauseFormulas kind value) =
        selectedPool domainFormula clauseFormulas kind value := by
  classical
  simp only [selectedPool, poolProjection_include]

omit [L.IsRelational] in
theorem selectedPool_boundary (kind : Kind) (coordinate : BoundaryVariables dimension kind) :
    selectedPool domainFormula clauseFormulas kind
      (poolBoundary (Carrier := Carrier) domainFormula clauseFormulas kind coordinate) =
        poolBoundary (Carrier := Carrier) domainFormula clauseFormulas kind coordinate := by
  classical
  simp only [selectedPool, poolBoundary, poolProjection_include]

/-- The mathematical equations generated by allocation: original boundary
identifications and collapse onto each occurrence's selected component. -/
noncomputable def allocatedEquations {variableCount : ℕ} (formula : SAT.Formula (Fin variableCount)) :
    AllocatedVariables (Carrier := Carrier) domainFormula clauseFormulas formula →
      AllocatedVariables (Carrier := Carrier) domainFormula clauseFormulas formula → Prop := by
  classical
  exact allocationEquations (includeVariable (occurrenceKind formula))
    (projectVariable (defaultHost (Carrier := Carrier) domainFormula clauseFormulas) (occurrenceKind formula))
    (boundaryIdentification
      (occurrenceBoundary (Carrier := Carrier) domainFormula clauseFormulas formula) (scope formula))

/-- Boundary equations and projection equations remove exactly the temporary
pool slots. They do not enlarge the mathematical output variable set. -/
noncomputable def AllocatedQuotient {variableCount : ℕ} (formula : SAT.Formula (Fin variableCount)) :
    Type carrierLevel :=
  Quot (allocatedEquations (Carrier := Carrier) domainFormula clauseFormulas formula)

omit [L.IsRelational] in
/-- To respect every allocation equation, it suffices and is necessary to
respect the pool projections and the boundary endpoints. Reflexive padding in
an equation array therefore imposes no additional assignment conditions. -/
theorem allocatedEquations_respects_iff {variableCount : ℕ} (formula : SAT.Formula (Fin variableCount))
    {Value : Type*}
    (assignment : AllocatedVariables (Carrier := Carrier) domainFormula clauseFormulas formula → Value) :
    (∀ first second, allocatedEquations domainFormula clauseFormulas formula first second →
      assignment first = assignment second) ↔
    (∀ occurrence value, assignment (.inr (occurrence, value)) =
      assignment (.inr (occurrence,
        selectedPool domainFormula clauseFormulas (occurrenceKind formula occurrence) value))) ∧
    (∀ occurrence coordinate,
      assignment (.inr (occurrence, poolBoundary (Carrier := Carrier) domainFormula clauseFormulas
        (occurrenceKind formula occurrence) coordinate)) =
          assignment (.inl (scope formula occurrence coordinate))) := by
  classical
  constructor
  · intro respects
    constructor
    · intro occurrence value
      exact respects _ _ (Or.inr rfl)
    · intro occurrence coordinate
      exact respects _ _ (Or.inl
        ⟨.inr ⟨occurrence, occurrenceBoundary domainFormula clauseFormulas formula occurrence coordinate⟩,
          .inl (scope formula occurrence coordinate), ⟨occurrence, coordinate, rfl, rfl⟩, rfl, rfl⟩)
  · rintro ⟨projections, boundaries⟩ first second related
    rcases related with ⟨left, right, ⟨occurrence, coordinate, rfl, rfl⟩, rfl, rfl⟩ | rfl
    · exact boundaries occurrence coordinate
    · rcases first with shared | ⟨occurrence, value⟩
      · rfl
      · exact projections occurrence value

noncomputable def allocatedQuotientEquiv {variableCount : ℕ} (formula : SAT.Formula (Fin variableCount)) :
    AllocatedQuotient (Carrier := Carrier) domainFormula clauseFormulas formula ≃
      ExpandedVariables (Carrier := Carrier) domainFormula clauseFormulas formula := by
  classical
  exact gluedVariablesEquiv (defaultHost (Carrier := Carrier) domainFormula clauseFormulas)
    (occurrenceKind formula) (occurrenceBoundary (Carrier := Carrier) domainFormula clauseFormulas formula)
    (scope formula)

omit [L.IsRelational] in
theorem allocatedQuotient_card {variableCount : ℕ} (formula : SAT.Formula (Fin variableCount)) :
    Nat.card (AllocatedQuotient (Carrier := Carrier) domainFormula clauseFormulas formula) =
      Nat.card (ExpandedVariables (Carrier := Carrier) domainFormula clauseFormulas formula) :=
  Nat.card_congr (allocatedQuotientEquiv domainFormula clauseFormulas formula)

/-- The allocated quotient carries the original glued structure, transported
through the proved equivalence of variable sets. -/
noncomputable instance allocatedStructure {variableCount : ℕ} (formula : SAT.Formula (Fin variableCount)) :
    L.Structure (AllocatedQuotient (Carrier := Carrier) domainFormula clauseFormulas formula) :=
  _root_.Equiv.inducedStructure (allocatedQuotientEquiv domainFormula clauseFormulas formula).symm

/-- One pool variable in one fresh occurrence, after all identifications. -/
noncomputable def allocatedLocal {variableCount : ℕ} (formula : SAT.Formula (Fin variableCount))
    (occurrence : Fin variableCount ⊕ Fin formula.length)
    (value : Pool (Carrier := Carrier) domainFormula clauseFormulas) :
    AllocatedQuotient (Carrier := Carrier) domainFormula clauseFormulas formula := by
  classical
  exact Quot.mk _ (.inr (occurrence, value))

omit [L.IsRelational] in
theorem allocatedLocal_apply {variableCount : ℕ} (formula : SAT.Formula (Fin variableCount))
    (occurrence : Fin variableCount ⊕ Fin formula.length)
    (value : Pool (Carrier := Carrier) domainFormula clauseFormulas) :
    allocatedQuotientEquiv domainFormula clauseFormulas formula
      (allocatedLocal domainFormula clauseFormulas formula occurrence value) =
      localVariable (occurrenceBoundary (Carrier := Carrier) domainFormula clauseFormulas formula) (scope formula)
        occurrence (poolProjection (defaultHost (Carrier := Carrier) domainFormula clauseFormulas)
          (occurrenceKind formula occurrence) value) := by
  classical
  rfl

/-- A shared source coordinate in the allocated quotient. -/
noncomputable def allocatedShared {variableCount : ℕ} (formula : SAT.Formula (Fin variableCount))
    (coordinate : Fin variableCount × Fin dimension) :
    AllocatedQuotient (Carrier := Carrier) domainFormula clauseFormulas formula := by
  classical
  exact Quot.mk _ (.inl coordinate)

omit [L.IsRelational] in
theorem allocatedLocal_selectedPool {variableCount : ℕ} (formula : SAT.Formula (Fin variableCount))
    (occurrence : Fin variableCount ⊕ Fin formula.length)
    (value : Pool (Carrier := Carrier) domainFormula clauseFormulas) :
    allocatedLocal domainFormula clauseFormulas formula occurrence value =
      allocatedLocal domainFormula clauseFormulas formula occurrence
        (selectedPool domainFormula clauseFormulas (occurrenceKind formula occurrence) value) := by
  classical
  apply Quot.sound
  exact Or.inr rfl

omit [L.IsRelational] in
theorem allocatedLocal_boundary {variableCount : ℕ} (formula : SAT.Formula (Fin variableCount))
    (occurrence : Fin variableCount ⊕ Fin formula.length)
    (coordinate : BoundaryVariables dimension (occurrenceKind formula occurrence)) :
    allocatedLocal domainFormula clauseFormulas formula occurrence
      (poolBoundary (Carrier := Carrier) domainFormula clauseFormulas (occurrenceKind formula occurrence) coordinate) =
        allocatedShared domainFormula clauseFormulas formula (scope formula occurrence coordinate) := by
  classical
  apply Quot.sound
  exact Or.inl ⟨.inr ⟨occurrence, occurrenceBoundary domainFormula clauseFormulas formula occurrence coordinate⟩,
    .inl (scope formula occurrence coordinate), ⟨occurrence, coordinate, rfl, rfl⟩, rfl, rfl⟩

/-- The actual output relations are precisely the images of the uniform local
pool tables. Inactive slots introduce no extra relations after projection. -/
theorem allocated_relMap_iff {variableCount arity : ℕ} (formula : SAT.Formula (Fin variableCount))
    (symbol : L.Relations arity)
    (tuple : Fin arity → AllocatedQuotient (Carrier := Carrier) domainFormula clauseFormulas formula) :
    Structure.RelMap symbol tuple ↔
      ∃ occurrence, ∃ localTuple : Fin arity → Pool (Carrier := Carrier) domainFormula clauseFormulas,
        poolRelation domainFormula clauseFormulas (occurrenceKind formula occurrence) symbol localTuple ∧
        (fun coordinate => allocatedLocal domainFormula clauseFormulas formula occurrence (localTuple coordinate)) =
          tuple := by
  classical
  change Structure.RelMap symbol (allocatedQuotientEquiv domainFormula clauseFormulas formula ∘ tuple) ↔ _
  dsimp only [poolRelation]
  constructor
  · rintro ⟨occurrence, localTuple, related, agrees⟩
    refine ⟨occurrence, fun coordinate => ⟨occurrenceKind formula occurrence, localTuple coordinate⟩, ?_, ?_⟩
    · simpa only [poolProjection_include] using related
    · funext coordinate
      apply (allocatedQuotientEquiv domainFormula clauseFormulas formula).injective
      rw [allocatedLocal_apply, poolProjection_include]
      exact congrFun agrees coordinate
  · rintro ⟨occurrence, localTuple, related, rfl⟩
    refine ⟨occurrence, fun coordinate =>
      poolProjection (defaultHost (Carrier := Carrier) domainFormula clauseFormulas)
        (occurrenceKind formula occurrence) (localTuple coordinate), related, ?_⟩
    funext coordinate
    exact (allocatedLocal_apply domainFormula clauseFormulas formula occurrence (localTuple coordinate)).symm

/-- The quotient's solutions are precisely assignments to the allocated
variables preserving every placed pool relation and every allocation equation.
This universal property is independent of numbering and serialization. -/
theorem allocated_satisfiable_iff_assignments {variableCount : ℕ} (formula : SAT.Formula (Fin variableCount)) :
    Satisfiable L (AllocatedQuotient (Carrier := Carrier) domainFormula clauseFormulas formula) Carrier ↔
    ∃ assignment : AllocatedVariables (Carrier := Carrier) domainFormula clauseFormulas formula → Carrier,
      (∀ occurrence arity (symbol : L.Relations arity)
        (tuple : Fin arity → Pool (Carrier := Carrier) domainFormula clauseFormulas),
        poolRelation domainFormula clauseFormulas (occurrenceKind formula occurrence) symbol tuple →
          Structure.RelMap symbol (fun coordinate => assignment (.inr (occurrence, tuple coordinate)))) ∧
      ∀ first second, allocatedEquations domainFormula clauseFormulas formula first second →
        assignment first = assignment second := by
  classical
  constructor
  · rintro ⟨homomorphism⟩
    refine ⟨fun value => homomorphism (Quot.mk _ value), ?_, ?_⟩
    · intro occurrence arity symbol tuple related
      exact homomorphism.map_rel symbol
        (fun coordinate => allocatedLocal domainFormula clauseFormulas formula occurrence (tuple coordinate))
        ((allocated_relMap_iff domainFormula clauseFormulas formula symbol _).mpr
          ⟨occurrence, tuple, related, rfl⟩)
    · intro first second related
      exact congrArg homomorphism (Quot.sound related)
  · rintro ⟨assignment, preserves, respects⟩
    refine ⟨{
      toFun := Quot.lift assignment respects
      map_fun' := fun symbol => isEmptyElim symbol
      map_rel' := ?_ }⟩
    intro arity symbol tuple related
    obtain ⟨occurrence, localTuple, localRelated, rfl⟩ :=
      (allocated_relMap_iff domainFormula clauseFormulas formula symbol tuple).mp related
    exact preserves occurrence arity symbol localTuple localRelated

/-- Uniform allocation preserves all homomorphism solutions. -/
theorem allocated_satisfiable_iff_expanded {variableCount : ℕ} (formula : SAT.Formula (Fin variableCount)) :
    Satisfiable L (AllocatedQuotient (Carrier := Carrier) domainFormula clauseFormulas formula) Carrier ↔
      Satisfiable L (ExpandedVariables (Carrier := Carrier) domainFormula clauseFormulas formula) Carrier := by
  let equivalence := _root_.Equiv.inducedStructureEquiv (L := L)
    (allocatedQuotientEquiv (Carrier := Carrier) domainFormula clauseFormulas formula).symm
  constructor
  · rintro ⟨homomorphism⟩
    exact ⟨homomorphism.comp equivalence.toHom⟩
  · rintro ⟨homomorphism⟩
    exact ⟨homomorphism.comp equivalence.symm.toHom⟩

/-- The fixed-pool construction has exactly the original Boolean formula's
solutions whenever the fixed pp gadget family realizes the Boolean quotient. -/
theorem allocated_satisfiable_iff
    {subalgebra : (polymorphismLanguage L Carrier).Substructure (Fin dimension → Carrier)}
    {quotient : subalgebra → Bool} {equalityFormula : L.Formula (Fin 2 × Fin dimension)}
    (family : IsBooleanGadgetFamily subalgebra quotient domainFormula equalityFormula clauseFormulas)
    (representatives : Bool → subalgebra) (sectionLaw : Function.RightInverse representatives quotient)
    {variableCount : ℕ} (formula : SAT.Formula (Fin variableCount)) :
    Satisfiable L (AllocatedQuotient (Carrier := Carrier) domainFormula clauseFormulas formula) Carrier ↔
      SAT.Formula.Satisfiable formula :=
  (allocated_satisfiable_iff_expanded domainFormula clauseFormulas formula).trans
    (satisfiable_iff family representatives sectionLaw formula)

end Polytime2.CSP.GadgetExpansion
