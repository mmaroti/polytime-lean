import Mathlib.ModelTheory.Substructures

/-! # Generated products and membership transport for SMP preparation

Mathlib's first-order structures in an algebraic language supply the algebras,
homomorphisms, and generated subalgebras. Empty generator families and empty
coordinate families require no separate generation convention.
-/

namespace Polytime2.SMP

open FirstOrder FirstOrder.Language

-- All carriers and the fixed signature have universe zero, as do encoded domains.
variable {L : Language.{0, 0}} [L.IsAlgebraic]
variable {Index : Type} {Carrier : Index → Type} [∀ index, L.Structure (Carrier index)]
variable {Source Target Generator : Type} [L.Structure Source] [L.Structure Target]

/-- The heterogeneous product uses the original operations coordinatewise. -/
instance productStructure : L.Structure (∀ index, Carrier index) where
  funMap symbol arguments index := Structure.funMap symbol (fun argument => arguments argument index)

/-- A coordinate projection is a homomorphism, including for nullary operations. -/
def projection (index : Index) : (∀ coordinate, Carrier coordinate) →[L] Carrier index where
  toFun value := value index
  map_fun' _ _ := rfl
  map_rel' relation := isEmptyElim relation

/-- Assemble homomorphisms to individual factors without a new product carrier. -/
def assemble (maps : ∀ index, Source →[L] Carrier index) : Source →[L] (∀ index, Carrier index) where
  toFun value index := maps index value
  map_fun' symbol arguments := by
    funext index
    exact (maps index).map_fun symbol arguments
  map_rel' relation := isEmptyElim relation

/-- Reindex a heterogeneous product, allowing repeated or omitted coordinates. -/
def reindexProduct {NewIndex : Type} (selection : NewIndex → Index) :
    (∀ index, Carrier index) →[L] (∀ index, Carrier (selection index)) :=
  assemble (fun index => projection (selection index))

/-- Repeating every coordinate at least once preserves all information. -/
theorem reindexProduct_injective {NewIndex : Type} (selection : NewIndex → Index)
    (surjective : Function.Surjective selection) :
    Function.Injective (reindexProduct (L := L) (Carrier := Carrier) selection) := by
  intro first second equal
  funext index
  obtain ⟨source, rfl⟩ := surjective index
  exact congrFun equal source

/-- Factor a homomorphism through an embedding when its image lies in the range. -/
noncomputable def liftThrough {Middle : Type} [L.Structure Middle]
    (inclusion : Middle ↪[L] Target) (map : Source →[L] Target)
    (inside : ∀ value, map value ∈ inclusion.toHom.range) : Source →[L] Middle :=
  inclusion.equivRange.symm.toHom.comp (map.codRestrict inclusion.toHom.range inside)

omit [L.IsAlgebraic] in
@[simp] theorem liftThrough_apply {Middle : Type} [L.Structure Middle]
    (inclusion : Middle ↪[L] Target) (map : Source →[L] Target)
    (inside : ∀ value, map value ∈ inclusion.toHom.range) (value : Source) :
    inclusion (liftThrough inclusion map inside value) = map value := by
  have equal := inclusion.equivRange.apply_symm_apply (map.codRestrict inclusion.toHom.range inside value)
  exact congrArg Subtype.val equal

/-- Projecting a full quotient graph gives exactly the quotient map's image. -/
theorem graph_projection_range {Domain QuotientValue Value : Type}
    (quotient : Domain → QuotientValue) (surjective : Function.Surjective quotient)
    (map : QuotientValue → Value) :
    Prod.fst '' {tuple : Value × Domain | tuple.1 = map (quotient tuple.2)} = Set.range map := by
  ext value
  constructor
  · rintro ⟨⟨_, source⟩, equal, rfl⟩
    exact ⟨quotient source, equal.symm⟩
  · rintro ⟨source, rfl⟩
    obtain ⟨representative, rfl⟩ := surjective source
    exact ⟨(map (quotient representative), representative), rfl, rfl⟩

/-- A coordinate image is generated by the corresponding generator column. -/
theorem coordinate_image (generators : Generator → ∀ index, Carrier index) (index : Index) :
    (Substructure.closure L (Set.range generators)).map (projection index) =
      Substructure.closure L (Set.range (fun generator => generators generator index)) := by
  rw [Substructure.map_closure, ← Set.range_comp]
  rfl

/-- A target outside one generated coordinate image cannot be generated. -/
theorem coordinate_obstruction (generators : Generator → ∀ index, Carrier index)
    (target : ∀ index, Carrier index) (index : Index)
    (outside : target index ∉ Substructure.closure L
      (Set.range (fun generator => generators generator index))) :
    target ∉ Substructure.closure L (Set.range generators) := by
  intro generated
  apply outside
  rw [← coordinate_image generators index]
  exact ⟨target, generated, rfl⟩

omit [L.IsAlgebraic] in
/-- A map of a generating family generates exactly its mathematical range. -/
theorem generated_image_full (map : Source →[L] Target) (generators : Generator → Source)
    (full : Substructure.closure L (Set.range generators) = ⊤) :
    (Substructure.closure L (Set.range (fun generator => map (generators generator))) :
      Set Target) = Set.range map := by
  rw [Set.range_comp', ← Substructure.map_closure, full]
  ext value
  constructor
  · rintro ⟨source, _, equal⟩
    exact ⟨source, equal⟩
  · rintro ⟨source, rfl⟩
    exact ⟨source, trivial, rfl⟩

omit [L.IsAlgebraic] in
/-- Generated images are exactly images of generated values, without requiring
injectivity or enumerating the growing generated subalgebra. -/
theorem generated_image_iff (map : Source →[L] Target) (generators : Generator → Source)
    (target : Target) :
    target ∈ Substructure.closure L (Set.range (fun generator => map (generators generator))) ↔
      ∃ source ∈ Substructure.closure L (Set.range generators), map source = target := by
  rw [Set.range_comp', ← Substructure.map_closure]
  rfl

omit [L.IsAlgebraic] in
/-- An injective homomorphism preserves and reflects the SMP question. -/
theorem generated_membership_iff (map : Source →[L] Target) (injective : Function.Injective map)
    (generators : Generator → Source) (target : Source) :
    map target ∈ Substructure.closure L (Set.range (fun generator => map (generators generator))) ↔
      target ∈ Substructure.closure L (Set.range generators) := by
  rw [generated_image_iff]
  constructor
  · rintro ⟨value, generated, equal⟩
    exact injective equal ▸ generated
  · intro generated
    exact ⟨target, generated, rfl⟩

/-- An injective homomorphism gives an actual algebra isomorphism of generated
subalgebras, preserving the same generator expressions and term witnesses. -/
noncomputable def generatedEquiv (map : Source →[L] Target) (injective : Function.Injective map)
    (generators : Generator → Source) :
    Substructure.closure L (Set.range generators) ≃[L]
      Substructure.closure L (Set.range (fun generator => map (generators generator))) := by
  let embedding : Source ↪[L] Target :=
    { toFun := map
      inj' := injective
      map_fun' := map.map_fun
      map_rel' := fun {_} symbol => isEmptyElim symbol }
  have equal : (Substructure.closure L (Set.range generators)).map embedding.toHom =
      Substructure.closure L (Set.range (fun generator => map (generators generator))) := by
    rw [Substructure.map_closure, ← Set.range_comp]
    rfl
  rw [← equal]
  exact embedding.substructureEquivMap _

/-- Subdirectness concerns the generated relation, not just its listed rows. -/
def IsSubdirect (relation : Set (∀ index, Carrier index)) : Prop :=
  ∀ index value, ∃ tuple ∈ relation, tuple index = value

/-- Full generated coordinate images establish subdirectness of the relation. -/
theorem generated_subdirect (generators : Generator → ∀ index, Carrier index)
    (full : ∀ index, Substructure.closure L
      (Set.range (fun generator => generators generator index)) = ⊤) :
    IsSubdirect (Substructure.closure L (Set.range generators) : Set (∀ index, Carrier index)) := by
  intro index value
  have generated : value ∈ (Substructure.closure L (Set.range generators)).map (projection index) := by
    rw [coordinate_image generators index, full index]
    trivial
  exact generated

end Polytime2.SMP
