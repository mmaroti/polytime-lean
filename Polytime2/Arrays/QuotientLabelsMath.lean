import Mathlib.Logic.Relation
import Mathlib.Logic.Equiv.Defs
import Mathlib.Data.List.Basic

/-! # Class labels for a finite list of equations

Start with identity labels and, for each equation, replace the second class's
label throughout the array by the first class's label. The resulting label
equality is exactly the equivalence relation generated by the equations.
Labels are actual fixed representatives; no search sentinel is exposed.
-/

namespace Polytime2.ArrayQuotient

universe elementLevel valueLevel

variable {Element : Type elementLevel} [DecidableEq Element]

section Merge

def merge (labels : Element → Element) (first second : Element) : Element → Element :=
  fun value => if labels value = labels second then labels first else labels value

theorem merge_preserves_equal (labels : Element → Element) (first second : Element)
    {left right : Element} (equal : labels left = labels right) :
    merge labels first second left = merge labels first second right := by
  simp only [merge, equal]

theorem merge_identifies (labels : Element → Element) (first second : Element) :
    merge labels first second first = merge labels first second second := by
  by_cases equal : labels first = labels second <;> simp [merge, equal]

theorem merge_idempotent {labels : Element → Element} (normal : ∀ value, labels (labels value) = labels value)
    (first second : Element) : ∀ value, merge labels first second (merge labels first second value) = merge labels first second value := by
  intro value
  by_cases hit : labels value = labels second
  · by_cases same : labels first = labels second <;> simp [merge, hit, normal, same]
  · simp [merge, hit, normal]

theorem merge_factors {Value : Type valueLevel} (observe : Element → Value)
    {labels : Element → Element} (keeps : ∀ value, observe (labels value) = observe value)
    {first second : Element} (equation : observe first = observe second) :
    ∀ value, observe (merge labels first second value) = observe value := by
  intro value
  by_cases hit : labels value = labels second
  · rw [merge, ite_eq_left hit]
    have same : observe value = observe second :=
      (keeps value).symm.trans ((congrArg observe hit).trans (keeps second))
    exact (keeps first).trans (equation.trans same.symm)
  · rw [merge, ite_eq_right hit]
    exact keeps value

end Merge

section Fold

def collapse (equations : List (Element × Element)) (labels : Element → Element) : Element → Element :=
  equations.foldl (fun current equation => merge current equation.1 equation.2) labels

def labels (equations : List (Element × Element)) : Element → Element := collapse equations id

theorem collapse_preserves_equal (equations : List (Element × Element))
    (initial : Element → Element) {first second : Element} (equal : initial first = initial second) :
    collapse equations initial first = collapse equations initial second := by
  induction equations generalizing initial with
  | nil => exact equal
  | cons equation rest hypothesis =>
    exact hypothesis _ (merge_preserves_equal initial equation.1 equation.2 equal)

theorem collapse_identifies (equations : List (Element × Element)) (initial : Element → Element)
    {first second : Element} (member : (first, second) ∈ equations) :
    collapse equations initial first = collapse equations initial second := by
  induction equations generalizing initial with
  | nil => simp at member
  | cons equation rest hypothesis =>
    rcases List.mem_cons.mp member with equal | member
    · subst equation
      exact collapse_preserves_equal rest _ (merge_identifies initial first second)
    · exact hypothesis _ member

theorem collapse_idempotent (equations : List (Element × Element))
    {initial : Element → Element} (normal : ∀ value, initial (initial value) = initial value) :
    ∀ value, collapse equations initial (collapse equations initial value) = collapse equations initial value := by
  induction equations generalizing initial with
  | nil => exact normal
  | cons equation rest hypothesis => exact hypothesis (merge_idempotent normal equation.1 equation.2)

theorem collapse_factors {Value : Type valueLevel} (observe : Element → Value)
    (equations : List (Element × Element))
    (respects : ∀ equation ∈ equations, observe equation.1 = observe equation.2)
    {initial : Element → Element} (keeps : ∀ value, observe (initial value) = observe value) :
    ∀ value, observe (collapse equations initial value) = observe value := by
  induction equations generalizing initial with
  | nil => exact keeps
  | cons equation rest hypothesis =>
    exact hypothesis (fun pair member => respects pair (List.mem_cons_of_mem _ member))
      (merge_factors observe keeps (respects equation (List.mem_cons_self)))

/-- The input equations, before taking their equivalence closure. -/
def equationRelation (equations : List (Element × Element)) (first second : Element) : Prop :=
  (first, second) ∈ equations

theorem labels_idempotent (equations : List (Element × Element)) : ∀ value, labels equations (labels equations value) = labels equations value :=
  collapse_idempotent equations (fun _ => rfl)

/-- Every function respecting the equations takes the same value at a vertex
and its chosen class representative. -/
theorem labels_factors {Value : Type valueLevel} (observe : Element → Value)
    (equations : List (Element × Element))
    (respects : ∀ equation ∈ equations, observe equation.1 = observe equation.2) (value : Element) :
    observe (labels equations value) = observe value :=
  collapse_factors observe equations respects (fun _ => rfl) value

theorem quotient_label (equations : List (Element × Element)) (value : Element) :
    Quot.mk (equationRelation equations) (labels equations value) =
      Quot.mk (equationRelation equations) value :=
  collapse_factors (Quot.mk (equationRelation equations)) equations
    (fun _ member => Quot.sound member) (fun _ => rfl) value

/-- Label equality is precisely the equivalence closure of the supplied
equations, regardless of their order, duplicates, or orientation. -/
theorem labels_equal_iff (equations : List (Element × Element)) (first second : Element) :
    labels equations first = labels equations second ↔
      Relation.EqvGen (equationRelation equations) first second := by
  constructor
  · intro equal
    apply Quot.eqvGen_exact
    exact (quotient_label equations first).symm.trans
      ((congrArg (Quot.mk (equationRelation equations)) equal).trans (quotient_label equations second))
  · intro related
    induction related with
    | rel first second member => exact collapse_identifies equations id member
    | refl value => rfl
    | symm _ _ _ equal => exact equal.symm
    | trans _ _ _ _ _ firstEqual secondEqual => exact firstEqual.trans secondEqual

/-- The fixed labels are actual representatives of the mathematical quotient.
This is the carrier equivalence used by later stable packing and numbering. -/
def representativeEquiv (equations : List (Element × Element)) :
    Quot (equationRelation equations) ≃ {value : Element // labels equations value = value} where
  toFun := Quot.lift (fun value => ⟨labels equations value, labels_idempotent equations value⟩)
    (fun _first _second member => Subtype.ext (collapse_identifies equations id member))
  invFun value := Quot.mk (equationRelation equations) value.val
  left_inv value := Quot.inductionOn value (fun value => quotient_label equations value)
  right_inv value := Subtype.ext value.property

end Fold

end Polytime2.ArrayQuotient
