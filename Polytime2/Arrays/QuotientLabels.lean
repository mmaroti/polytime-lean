import Polytime2.Arrays.QuotientLabelsMath
import Polytime2.Arrays.ReplaceValues
import Polytime2.Arrays.BoundedPositions
import Polytime2.Arrays.Operations

/-! # Certified equation-class labels

Labels and equations use ordinary finite coordinates and the existing bounded
index codec. Class merging is two lookups followed by pointwise replacement;
the complete label array is an ordinary certified fold from identity labels.
-/

set_option backward.isDefEq.respectTransparency false

namespace Polytime2.Computation

open EncodedDomain

variable {Parameter : Type} [Fintype Parameter]

private noncomputable def mergeLabels (vertices : MvPolynomial Parameter ℕ) :
    Computation Parameter Bool where
  inputDomains name := if name then (boundedIndex vertices).prod (boundedIndex vertices)
    else (boundedIndex vertices).arrayOfLength vertices
  outputDomain := (boundedIndex vertices).arrayOfLength vertices
  precondition _ _ := True
  compute _ arguments := ArrayQuotient.merge (arguments.val false) (arguments.val true).1 (arguments.val true).2

private theorem mergeLabels_realizable (vertices : MvPolynomial Parameter ℕ) :
    (mergeLabels vertices).Realizable := by
  let index := boundedIndex vertices
  let computation := mergeLabels vertices
  let inputs := computation.inputDomains
  have endpoints := Realizable.argument inputs true (fun _ _ => True)
  have endpoint (second : Bool) : (Computation.mk inputs index (fun _ _ => True)
      (fun _ arguments => if second then (arguments.val true).2 else (arguments.val true).1)).Realizable := by
    cases second
    · exact endpoints.fst
    · exact endpoints.snd
  have read (second : Bool) := (arrayLookup_realizable index vertices).onResults inputs (fun _ _ => True)
    (fun name _ arguments => match name with
      | false => if second then (arguments.val true).2 else (arguments.val true).1
      | true => arguments.val false) (by intros; trivial) (by
        intro name
        cases name
        · exact endpoint second
        · exact Realizable.argument inputs false (fun _ _ => True))
  have result := (arrayReplaceValues_realizable index vertices).onResults inputs (fun _ _ => True)
    (fun name _ arguments => match name with
      | .inl false => arguments.val false (arguments.val true).2
      | .inl true => arguments.val false (arguments.val true).1
      | .inr () => arguments.val false) (by intros; trivial) (by
        intro name
        rcases name with second | unitValue
        · cases second
          · exact read true
          · exact read false
        · exact Realizable.argument inputs false (fun _ _ => True))
  exact result.withSpecification computation.precondition computation.compute
    (by intros; trivial) (by
      intro sizes arguments valid
      simp only [onResults, arrayReplaceValues, arrayTransform, computation, mergeLabels]
      funext position
      dsimp only [ArrayQuotient.merge]
      split_ifs <;> rfl)


/-- Return class representatives for the equivalence relation generated by
the input equations. Both vertex and equation counts are mathematical sizes. -/
noncomputable def quotientLabels (vertices equations : MvPolynomial Parameter ℕ) :
    Computation Parameter Unit :=
  unaryMap (((boundedIndex vertices).prod (boundedIndex vertices)).arrayOfLength equations)
    ((boundedIndex vertices).arrayOfLength vertices) (fun _ _ => True)
    (fun _ arguments => ArrayQuotient.labels (List.ofFn arguments.val))

theorem quotientLabels_realizable (vertices equations : MvPolynomial Parameter ℕ) :
    (quotientLabels vertices equations).Realizable := by
  classical
  let index := boundedIndex vertices
  let element := index.prod index
  let accumulator := index.arrayOfLength vertices
  let context : Empty → EncodedDomain Parameter := Empty.elim
  let update sizes (_ : ∀ name, (context name).Carrier sizes)
      (labels : accumulator.Carrier sizes) (equation : element.Carrier sizes) :=
    ArrayQuotient.merge labels equation.1 equation.2
  have step : (arrayFoldStep context element accumulator (fun _ _ _ _ => True) update).Realizable := by
    exact (mergeLabels_realizable vertices).onArguments _ (fun _ _ => True)
      Sum.inr (by intro name; cases name <;> rfl) (by intros; trivial)
  have folded := arrayFold_total_realizable context element accumulator equations update step
  let computation := quotientLabels vertices equations
  have initial := (arrayBoundedPositions_realizable vertices).withArguments computation.inputDomains
    ⟨Empty.elim, by intro name; exact name.elim⟩ (by intro name; exact name.elim)
  have result := folded.onResults computation.inputDomains computation.precondition
    (fun name sizes arguments => match name with
      | .inl empty => empty.elim
      | .inr false => id
      | .inr true => arguments.val ()) (by intros; trivial) (by
        intro name
        rcases name with empty | initialOrArray
        · exact empty.elim
        · cases initialOrArray
          · exact initial
          · exact Realizable.argument computation.inputDomains () computation.precondition)
  apply result.withSpecification computation.precondition computation.compute (by intros; trivial)
  intro sizes arguments valid
  simp [onResults, arrayFold, ArrayFold.prefixValue, computation, quotientLabels, unaryMap,
    ArrayQuotient.labels, ArrayQuotient.collapse, update]
  rw [List.take_of_length_le List.length_ofFn.le]
  rfl

/-- The certified output labels identify precisely the input equation classes. -/
theorem quotientLabels_correct (vertices equations : MvPolynomial Parameter ℕ)
    (sizes : Parameter → ℕ)
    (input : Fin (MvPolynomial.eval sizes equations) →
      Fin (MvPolynomial.eval sizes vertices) × Fin (MvPolynomial.eval sizes vertices))
    (first second : Fin (MvPolynomial.eval sizes vertices)) :
    (quotientLabels vertices equations).compute sizes ⟨fun _ => input, trivial⟩ first =
        (quotientLabels vertices equations).compute sizes ⟨fun _ => input, trivial⟩ second ↔
      Relation.EqvGen (ArrayQuotient.equationRelation (List.ofFn input)) first second :=
  ArrayQuotient.labels_equal_iff (List.ofFn input) first second


end Polytime2.Computation
